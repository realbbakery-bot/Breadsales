{
	email {$ACME_EMAIL}
	# Certificates are issued automatically, but only for domains the app confirms are bakeries.
	on_demand_tls {
		ask http://app:3000/internal/tls-check
	}
}

# Your private owner console (customers never see this address).
{$OWNER_DOMAIN} {
	reverse_proxy app:3000
}

# Every bakery domain.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}
