# Password for the owner console (at least 10 characters). Keep it secret.
OWNER_PASSWORD=change-me-to-something-long
# The address of your owner console, e.g. console.alamalkhubz.com (point its DNS A record at this server).
OWNER_DOMAIN=console.example.com
# Email used for HTTPS certificate notices.
ACME_EMAIL=you@example.com
# Timezone for bake days and order cutoffs.
TZ=Asia/Riyadh
